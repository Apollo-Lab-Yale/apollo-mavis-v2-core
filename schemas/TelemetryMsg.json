    "CalibrationValidation": {
      "description": "Stationary-controller validation result (13-tracker \u00a74).\n\nAcceptance (2026-09-03 measurements): every axis ``std_mm`` below\n``threshold_std_mm`` and ``max_step_mm`` below ``threshold_step_mm``.",
      "properties": {
        "max_step_mm": {
          "default": 0.0,
          "title": "Max Step Mm",
          "type": "number"
        },
        "passed": {
          "default": false,
          "title": "Passed",
          "type": "boolean"
        },
        "samples": {
          "default": 0,
          "title": "Samples",
          "type": "integer"
        },
        "std_mm": {
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Std Mm",
          "type": "array"
        },
        "threshold_std_mm": {
          "default": 5.0,
          "title": "Threshold Std Mm",
          "type": "number"
        },
        "threshold_step_mm": {
          "default": 20.0,
          "title": "Threshold Step Mm",
          "type": "number"
        }
      },
      "title": "CalibrationValidation",
      "type": "object"
    },
