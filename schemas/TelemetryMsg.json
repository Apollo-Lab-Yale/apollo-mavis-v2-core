{
  "$defs": {
    "ArmTelemetry": {
      "description": "Per-arm telemetry block.",
      "properties": {
        "arm_id": {
          "title": "Arm Id",
          "type": "string"
        },
        "connected": {
          "title": "Connected",
          "type": "boolean"
        },
        "ee_pose": {
          "$ref": "#/$defs/PoseMsg"
        },
        "error_code": {
          "title": "Error Code",
          "type": "integer"
        },
        "goto": {
          "anyOf": [
            {
              "enum": [
                "planning",
                "executing",
                "failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Goto"
        },
        "gripper_open_frac": {
          "title": "Gripper Open Frac",
          "type": "number"
        },
        "q": {
          "items": {
            "type": "number"
          },
          "title": "Q",
          "type": "array"
        },
        "rail_pos_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rail Pos M"
        },
        "stale": {
          "default": false,
          "title": "Stale",
          "type": "boolean"
        },
        "warn_code": {
          "default": 0,
          "title": "Warn Code",
          "type": "integer"
        }
      },
      "required": [
        "arm_id",
        "connected",
        "q",
        "rail_pos_m",
        "ee_pose",
        "gripper_open_frac",
        "error_code"
      ],
      "title": "ArmTelemetry",
      "type": "object"
    },
    "ClearanceItem": {
      "description": "One monitored geometry pair at the measured config.",
      "properties": {
        "dist_m": {
          "title": "Dist M",
          "type": "number"
        },
        "pair": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "title": "Pair",
          "type": "array"
        }
      },
      "required": [
        "pair",
        "dist_m"
      ],
      "title": "ClearanceItem",
      "type": "object"
    },
    "CollisionEvent": {
      "description": "Rich per-transition collision-gate event (additive detail).",
      "properties": {
        "arm_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Arm Ids",
          "type": "array"
        },
        "dists_m": {
          "items": {
            "type": "number"
          },
          "title": "Dists M",
          "type": "array"
        },
        "kind": {
          "enum": [
            "blocked",
            "cleared",
            "warn",
            "penetration",
            "stale_twin"
          ],
          "title": "Kind",
          "type": "string"
        },
        "min_clearance_m": {
          "title": "Min Clearance M",
          "type": "number"
        },
        "pairs": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Pairs",
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommandSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "t": {
          "const": "collision_event",
          "default": "collision_event",
          "title": "T",
          "type": "string"
        },
        "ts": {
          "title": "Ts",
          "type": "number"
        }
      },
      "required": [
        "ts",
        "kind",
        "pairs",
        "dists_m",
        "min_clearance_m"
      ],
      "title": "CollisionEvent",
      "type": "object"
    },
    "CollisionReport": {
      "description": "Gate verdict for one check; the UI shape (05-ui \u00a72).",
      "properties": {
        "blocked": {
          "title": "Blocked",
          "type": "boolean"
        },
        "min_clearance_m": {
          "default": 1.0,
          "title": "Min Clearance M",
          "type": "number"
        },
        "pairs": {
          "default": [],
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Pairs",
          "type": "array"
        },
        "severity": {
          "enum": [
            "ok",
            "warn",
            "blocked"
          ],
          "title": "Severity",
          "type": "string"
        },
        "ts": {
          "default": 0.0,
          "title": "Ts",
          "type": "number"
        },
        "violations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CollisionEvent"
          },
          "title": "Violations",
          "type": "array"
        }
      },
      "required": [
        "blocked",
        "severity"
      ],
      "title": "CollisionReport",
      "type": "object"
    },
    "CommandSource": {
      "description": "Origin of the command stream a safety event refers to.",
      "enum": [
        "teleop",
        "joint_jog",
        "policy",
        "takeover",
        "planner"
      ],
      "title": "CommandSource",
      "type": "string"
    },
    "ControlMode": {
      "enum": [
        "policy",
        "human",
        "takeover_transition"
      ],
      "title": "ControlMode",
      "type": "string"
    },
    "ControllerTelemetry": {
      "description": "Raw Vive-controller input state (13-tracker \u00a71.1), additive.\n\nMirrors the libsurvive button/axis events for the tracked object. Axis\nconventions: ``trigger`` 0..1; ``trackpad_x``/``trackpad_y`` -1..1 with\n+y = top. ``trackpad_touch`` is finger contact, ``trackpad_click`` the\nphysical press. ``menu`` + ``system`` is the pairing combo (never mapped).",
      "properties": {
        "grip": {
          "default": false,
          "title": "Grip",
          "type": "boolean"
        },
        "menu": {
          "default": false,
          "title": "Menu",
          "type": "boolean"
        },
        "system": {
          "default": false,
          "title": "System",
          "type": "boolean"
        },
        "trackpad_click": {
          "default": false,
          "title": "Trackpad Click",
          "type": "boolean"
        },
        "trackpad_touch": {
          "default": false,
          "title": "Trackpad Touch",
          "type": "boolean"
        },
        "trackpad_x": {
          "default": 0.0,
          "title": "Trackpad X",
          "type": "number"
        },
        "trackpad_y": {
          "default": 0.0,
          "title": "Trackpad Y",
          "type": "number"
        },
        "trigger": {
          "default": 0.0,
          "title": "Trigger",
          "type": "number"
        },
        "trigger_pressed": {
          "default": false,
          "title": "Trigger Pressed",
          "type": "boolean"
        }
      },
      "title": "ControllerTelemetry",
      "type": "object"
    },
    "DaggerStatus": {
