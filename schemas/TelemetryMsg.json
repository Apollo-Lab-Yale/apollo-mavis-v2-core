    "TrackerSettingsMsg": {
      "description": "Live tracker teleop settings echoed in telemetry (13-tracker \u00a73.5, \u00a74).\n\nThe ``filter_*`` fields are the *effective* One Euro pose-filter settings\n(config defaults, overridable live via ``tracker_settings``); they default\nhere so pre-filter producers still validate.",
      "properties": {
        "filter_beta": {
          "default": 0.05,
          "title": "Filter Beta",
          "type": "number"
        },
        "filter_enabled": {
          "default": true,
          "title": "Filter Enabled",
          "type": "boolean"
        },
        "filter_min_cutoff_hz": {
          "default": 1.0,
          "title": "Filter Min Cutoff Hz",
          "type": "number"
        },
        "follow_rotation": {
          "title": "Follow Rotation",
          "type": "boolean"
        },
        "pos_scale": {
