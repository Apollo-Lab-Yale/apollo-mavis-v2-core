        "pose_world": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoseMsg"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rate_hz": {
          "default": 0.0,
          "title": "Rate Hz",
          "type": "number"
        },
        "seq": {
          "default": 0,
          "title": "Seq",
          "type": "integer"
        },
        "settings": {
          "$ref": "#/$defs/TrackerSettingsMsg"
        },
        "status": {
          "enum": [
            "no_backend",
            "starting",
            "searching",
            "tracking",
            "stale",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "target_tcp": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoseMsg"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "backend",
        "status",
        "settings"
      ],
      "title": "TrackerTelemetry",
      "type": "object"
    },
