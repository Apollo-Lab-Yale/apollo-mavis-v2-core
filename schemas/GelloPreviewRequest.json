{
  "description": "``POST /api/gello/preview`` body (16-gello \u00a75.4). ``scene`` None = the runtime's\n``gello.scene_id``; ``speed_scale`` None = the kind's default (it only annotates the\ncheck \u2014 the preview never moves anything).",
  "properties": {
    "kind": {
      "enum": [
        "hardware",
        "sim"
      ],
      "title": "Kind",
      "type": "string"
    },
    "scene": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scene"
    },
    "speed_scale": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Speed Scale"
    }
  },
  "required": [
    "kind"
  ],
  "title": "GelloPreviewRequest",
  "type": "object"
}
