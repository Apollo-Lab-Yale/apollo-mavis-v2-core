{
  "$defs": {
    "ArmPosture": {
      "description": "One arm's stored posture; ``q`` NEVER includes the rail slot.",
      "properties": {
        "gripper_open_frac": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Gripper Open Frac",
          "type": "number"
        },
        "q": {
          "items": {
            "type": "number"
          },
          "maxItems": 7,
          "minItems": 7,
          "title": "Q",
          "type": "array"
        },
        "rail_pos_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rail Pos M"
        }
      },
      "required": [
        "q"
      ],
      "title": "ArmPosture",
      "type": "object"
    }
  },
  "description": "Named workcell posture snapshot; at most one initial condition per kind.",
  "properties": {
    "arms": {
      "additionalProperties": {
        "$ref": "#/$defs/ArmPosture"
      },
      "title": "Arms",
      "type": "object"
    },
    "created_at": {
      "default": "",
      "title": "Created At",
      "type": "string"
    },
    "is_initial_condition": {
      "default": false,
      "title": "Is Initial Condition",
      "type": "boolean"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    },
    "profile_id": {
      "default": "",
      "title": "Profile Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "workcell_kind": {
      "enum": [
        "hardware",
        "sim"
      ],
      "title": "Workcell Kind",
      "type": "string"
    }
  },
  "required": [
    "name",
    "workcell_kind",
    "arms"
  ],
  "title": "StateProfile",
  "type": "object"
}
